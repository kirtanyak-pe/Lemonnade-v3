{
  "name": "figma-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.ts",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens && npm run agent-docs",
    "agent-docs": "node --no-warnings scripts/build-agent-docs.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "icons": "node scripts/sync-icons.ts",
    "deploy:docs": "bash scripts/deploy-docs.sh"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
