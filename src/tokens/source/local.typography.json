{
  "$description": "Not in Figma as a text style — values Figma uses unbound. Merged into typography.css.",
  "font": {
    "size": {
      "local": {
        "08": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Chip tab sub label (Figma L3: base tab, 👁️ Sub label: Manrope SemiBold 8/10, no text style)."
        }
      }
    }
  },
  "line-height": {
    "local": {
      "10": {
        "$type": "dimension",
        "$value": "10px"
      }
    }
  },
  "text": {
    "label": {
      "primary": {
        "08": {
          "$type": "typography",
          "$value": {
            "fontFamily": "{font.family.manrope}",
            "fontWeight": "{font.weight.semibold}",
            "fontSize": "{font.size.local.08}",
            "lineHeight": "{line-height.local.10}",
            "letterSpacing": "0px",
            "paragraphSpacing": "{paragraph-spacing.00}"
          },
          "$extensions": {
            "l3.figmaStyle": "local — chip tab sub label (8/10)",
            "l3.local": "Not a Figma text style; Figma uses SemiBold 8/10 unbound on the chip sub label."
          }
        }
      }
    }
  }
}
