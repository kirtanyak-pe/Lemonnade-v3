    ],
    "text": {
      "Heading": [
        10,
        12,
        14,
        16,
        18,
        20,
        24,
        28,
        32,
        36
      ],
      "Label": [
        10,
        12,
        14,
        16,
        18
      ],
      "Description": [
        10,
        12,
        14,
        16,
        18
      ]
    }
  },
  "text": {
    "$note": "Role from the old style name ('extrabold - Heading/N' → Heading, 'semibold - Label/N' → Label) or from weight: ≥700 Heading, ≥600 Label, numbers/prices Label, otherwise Description. Size snaps to the nearest step of that role. Guards: only inside phone screens (340–430 wide, ≥500 tall), ≤40px (section labels and display text untouched), hidden texts (width ≤ 2) ignored; if a text would wrap: hug if fixed-width, else the lighter role at the same size, else restore exactly.",
    "oldStylePattern": "(extrabold - Heading|semibold - Label)\\/(\\d+)$",
    "numberLike": "only digits, ₹ $ . , % + − - : / ( ) x × and Cr / L / K / lakh"
  },
  "components": [
    {
      "match": "Version = ❌ Discontinued (any L3 set)",
      "to": "same set, Version = Latest",
      "strategy": "latest",
      "proven": "Overlay, Bottom sheet, Bottom sheet header"
    },
    {
      "match": "D2 Actionbar (same structure)",
      "to": "L3: Actionbar",
      "strategy": "variant-swap",
      "proven": "30 instances"
    },
    {
      "match": "D2 Tabs (pill row)",
      "to": "L3: Tabs group, Type = Pill tabs",
      "strategy": "variant-swap + padding compensation",
      "proven": "15 instances (tabs grew 64 → 88; kept via instance padding)"
    },
    {
      "match": "old Pills / chips",
      "to": "L3: base tab, isPill = True",
      "strategy": "variant-swap + padding compensation",
      "proven": "7 instances"
    },
    {
      "match": "icons from any other library",
      "to": "👁️ Lemonnade V3 → Icons 'D2 → <same material name>'",
      "strategy": "variant-swap (keep size and colour)",
      "proven": "114 instances; keyboard_arrow_down is NOT importable → use expand_more"
    },
    {
      "match": "bordered asset/list card (radius 12, border, padding 12)",
      "to": "L3: Card, Type = Static, isPadded = True",
      "strategy": "slot-wrap",
      "proven": "27 ❌ Asset list card (isPlain=False)"
    },
    {
      "match": "flat list row (icon + name/price column + trailing)",
      "to": "L3: list cell (isSmall/isPlain from the old row)",
      "strategy": "rebuild:list-cell",
      "proven": "18 ❌ Asset list card (isPlain=True) — rows are list cells, NOT Card Flat"
    },
    {
      "match": "order-pad bottom bar (funds info + main button)",
      "to": "L3: Button Dock, Direction = ↓ Vertical",
      "strategy": "slot-wrap",
      "proven": "15 CTAs"
    },
    {
      "match": "grey inset panel (surface/secondary, radius 12, no border)",
      "to": "L3: Card, Type = Filled",
      "strategy": "slot-wrap",
      "proven": "added 2026-10-09 for CMD Asset page details"
    },
    {
      "match": "quantity control (− value +)",
      "to": "L3: Stepper (Small inline / Large standalone)",
      "strategy": "rebuild:stepper",
      "proven": "20 (17 Small, 3 Large)"
    },
    {
      "match": "text + ↕ / ⌄ trigger",
      "to": "L3: Select (size from text style, isSubtle from colour, chevron icon for ⌄)",
      "strategy": "rebuild:select",
      "proven": "52"
    },
    {
      "match": "signed number text (+0.68%, −252.89 (0.05%))",
      "to": "L3: Price change (Direction from the sign)",
      "strategy": "rebuild:price-change",
      "proven": "new 2026-10-09; fixes sign/colour mismatches"
    },
    {
      "match": "nested local cards inside a LOCAL main (instance sublayers)",
      "to": "edit the main once; restore per-instance text overrides by order",
      "strategy": "main-edit",
      "proven": "Quick access indices (16 instances)"
    },
    {
      "match": "hand-drawn candle / line chart",
      "to": "L3: Chart (Type, Trend) + controls laid on top",
      "strategy": "manual (slot-wrap not possible)",
      "proven": "pending publish"
    },
    {
      "match": "thin track + fill bars",
      "to": "L3: Progress bar",
      "strategy": "rebuild (Value in steps of 10)",
      "proven": "—"
    }
  ],
  "keepAsIs": [
    "Section label cards and display text > 40px (presentation, not product UI)",
    "INFO ICON two-tone and empty 'Icon Size=M' placeholders — designer decision",
    "Option-chain 2px OI bars (chart data; no 2px size token)",
    "Logos (use L3 → Brand logo when replacing)"
  ],
  "colorPatterns": [
    {
      "re": "^color/❌? ?\\[?Discontinued\\]? ?button/(primary|secondary|tertiary|ghost|brand|buy|sell)/(background|bg|surface)$",
      "to": "component/button/$1/surface"
    },
    {
      "re": "^color/button/(primary|secondary|tertiary|ghost|brand|buy|sell)/(background|bg|surface)$",
      "to": "component/button/$1/surface"
    },
    {
      "re": "^color/button/(primary|secondary|tertiary|ghost|brand|buy|sell)/(label|icon|text|content)$",
      "to": "component/button/$1/content"
    },
    {
      "re": "^color/button/(primary|secondary|tertiary|ghost|brand|buy|sell)/(border|stroke)$",
      "to": "component/button/$1/border"
    },
    {
      "re": "^color/hue/honey/(\\d00)$",
      "to": "extra/gold/$1"
    }
  ]
}
